generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogLevel {
  info
  warn
  error
}

model LogEntry {
  id        String   @id @default(uuid())
  deployId  String   @map("deploy_id")
  timestamp DateTime @default(now())
  level     LogLevel
  message   String

  @@index([deployId, timestamp(sort: Desc)])
  @@map("log_entries")
}

// IRD-002 §6: every retention purge run is recorded here, success or failure.
model PurgeAuditLog {
  id           String   @id @default(uuid())
  ranAt        DateTime @default(now()) @map("ran_at")
  cutoff       DateTime
  deletedCount Int      @map("deleted_count")
  status       String   @default("success")
  errorMessage String?  @map("error_message")

  @@map("purge_audit_log")
}
