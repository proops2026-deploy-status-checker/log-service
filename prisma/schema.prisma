generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogLevel {
  info
  warn
  error
}

model LogEntry {
  id        String   @id @default(uuid())
  deployId  String   @map("deploy_id")
  timestamp DateTime @default(now())
  level     LogLevel
  message   String

  @@index([deployId, timestamp(sort: Desc)])
  @@map("log_entries")
}
